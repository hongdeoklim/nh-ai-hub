# cad-job-gateway Edge Function 환경변수
# supabase secrets set --env-file .env.example 으로 등록

# 필수 (nh-ai-hub 공통)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# cad-job-gateway 전용 웹훅 시크릿
# openssl rand -hex 32 로 생성 후 등록
CAD_GATEWAY_SECRET=<random-32-byte-hex>
