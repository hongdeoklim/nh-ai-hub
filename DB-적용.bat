@echo off
chcp 65001 >nul
cd /d "%~dp0"
title NH-AX-HUB DB 마이그레이션 적용
echo ============================================================
echo   NH-AX-HUB  -  적용 안 된 DB 마이그레이션 적용
echo ============================================================
echo.
echo 아직 원격 DB에 적용되지 않은 SQL 만 골라서 적용합니다.
echo (이미 적용된 것은 자동으로 건너뜁니다.)
echo.
echo [1/2] 적용 대상 확인 -----------------------------------------
call npx supabase migration list
echo.
echo [2/2] 적용 -------------------------------------------------
echo 아래에서 적용할 목록이 표시되면  Y  를 눌러 진행하세요.
echo (적용할 게 없으면 "Remote database is up to date" 라고 나옵니다.)
echo.
call npx supabase db push
echo.
echo ============================================================
echo   완료. 창을 닫으려면 아무 키나 누르세요.
echo ============================================================
pause >nul
